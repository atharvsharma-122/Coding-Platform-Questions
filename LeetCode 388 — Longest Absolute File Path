class Solution:
    def lengthLongestPath(self, input: str) -> int:
        stack = [0]
        max_length = 0

        for line in input.split('\n'):
            depth = line.count('\t')
            name = line[depth:]

            while len(stack) > depth + 1:
                stack.pop()

            current_length = stack[-1] + len(name)

            if '.' in name:
                max_length = max(max_length, current_length)
            else:
                stack.append(current_length + 1)

        return max_length
