class Solution {
    public int preimageSizeFZF(int k) {
        long left = 0;
        long right = 5L * (k + 1);

        while (left < right) {
            long mid = left + (right - left) / 2;

            if (countZeroes(mid) < k) {
                left = mid + 1;
            } else {
                right = mid;
            }
        }

        long first = left;

        left = 0;
        right = 5L * (k + 1);

        while (left < right) {
            long mid = left + (right - left) / 2;

            if (countZeroes(mid) <= k) {
                left = mid + 1;
            } else {
                right = mid;
            }
        }

        return (int)(left - first);
    }

    private long countZeroes(long n) {
        long count = 0;

        while (n > 0) {
            n /= 5;
            count += n;
        }

        return count;
    }
}
