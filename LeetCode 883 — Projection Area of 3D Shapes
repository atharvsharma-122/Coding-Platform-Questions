class Solution:
    def projectionArea(self, grid: List[List[int]]) -> int:
        top = 0
        front = 0
        side = 0

        for row in grid:
            front += max(row)

            for height in row:
                if height > 0:
                    top += 1

        for col in zip(*grid):
            side += max(col)

        return top + front + side
