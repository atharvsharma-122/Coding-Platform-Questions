class Solution {
    public int[] loudAndRich(int[][] richer, int[] quiet) {
        int n = quiet.length;

        List<Integer>[] graph = new ArrayList[n];
        for (int i = 0; i < n; i++) {
            graph[i] = new ArrayList<>();
        }

        for (int[] r : richer) {
            graph[r[1]].add(r[0]); // poorer -> richer
        }

        int[] ans = new int[n];
        Arrays.fill(ans, -1);

        for (int i = 0; i < n; i++) {
            dfs(i, graph, quiet, ans);
        }

        return ans;
    }

    private int dfs(int node, List<Integer>[] graph,
                    int[] quiet, int[] ans) {

        if (ans[node] != -1) return ans[node];

        ans[node] = node;

        for (int next : graph[node]) {
            int candidate = dfs(next, graph, quiet, ans);

            if (quiet[candidate] < quiet[ans[node]]) {
                ans[node] = candidate;
            }
        }

        return ans[node];
    }
}
